+   * under: it is collected rather than nested, so the filter both arms share
+   * carries it.
+   *
+   * @param string[] $text_fields
+   *   The analyzed text fields of the collection.
+   * @param array $keys
+   *   A parsed key group: its `#conjunction` decides whether a row has to
+   *   carry every key or one, and a nested group's `#negation` excludes it.
+   * @param array $excluded
+   *   Collects the clauses a row must match none of.
+   *
+   * @return array
+   *   The clause, or an empty array when the group holds nothing positive.
+   */
+  protected function keysClause(array $text_fields, array $keys, array &$excluded): array {
+    $any = strtoupper((string) ($keys['#conjunction'] ?? 'AND')) === 'OR';
+    $terms = $positive = [];
+    foreach ($keys as $key => $value) {
+      if (is_string($key) && str_starts_with($key, '#')) {
+        continue;
+      }
+      if (is_array($value)) {
+        $nested = $this->keysClause($text_fields, $value, $excluded);
+        if ($nested === []) {
+          continue;
+        }
+        if (empty($value['#negation'])) {
+          $positive[] = $nested;
+        }
+        else {
+          $excluded[] = $nested;
+        }
+      }
+      elseif (($term = trim((string) $value)) !== '') {
