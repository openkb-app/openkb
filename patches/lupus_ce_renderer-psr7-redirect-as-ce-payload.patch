   /**
+   * Tests that a PSR-7 redirect is provided as a redirect response too.
+   *
+   * Left as a raw 3xx it would leave the API for the client's own HTTP layer
+   * to follow server-side, which for an OAuth authorization code means
+   * spending it against a callback the real client is waiting on.
+   */
+  public function testPsr7RedirectIsProvidedAsRedirectResponse() {
+    $this->container->get('current_user')->setAccount($this->adminUser);
+
+    $request = Request::create('/lupus-ce-renderer-test/psr7-redirect', 'GET', ['_format' => 'custom_elements']);
+    $response = $this->container->get('http_kernel')->handle($request);
+
+    $this->assertEquals(200, $response->getStatusCode(), 'No raw 3xx leaves the API.');
+    $data = json_decode($response->getContent(), TRUE);
+    $this->assertArrayHasKey('redirect', $data, 'A PSR-7 redirect returns a redirect response.');
+    $this->assertEquals('https://example.com/callback?code=abc', $data['redirect']['url']);
+    $this->assertTrue($data['redirect']['external']);
+    $this->assertEquals(302, $data['redirect']['statusCode']);
+  }
+
