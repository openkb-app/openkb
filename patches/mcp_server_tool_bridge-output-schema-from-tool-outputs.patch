   /**
+   * Converts a tool's output definitions to an MCP output schema.
+   *
+   * The schema describes what execute() answers, which is the
+   * {success, message, data} envelope with the tool's own outputs under
+   * data. Nothing inside data is marked required: a tool that sets no output
+   * values falls back to the result's context values, which are keyed
+   * independently of the output definitions.
+   *
+   * @return array|null
+   *   The schema, or NULL for a tool that declares no outputs — an advertised
+   *   outputSchema is a promise about the result, so a tool that promises
+   *   nothing must not carry one.
+   */
+  private function convertToMcpOutputSchema(ToolDefinition $definition): ?array {
+    $definitions = $definition->getOutputDefinitions();
+    if ($definitions === []) {
+      return NULL;
+    }
+
+    $properties = [];
+    foreach ($definitions as $name => $output_definition) {
+      $properties[$name] = $this->convertInputDefinitionToSchema($output_definition);
+    }
+
+    return [
+      'type' => 'object',
+      'properties' => [
+        'success' => ['type' => 'boolean'],
+        'message' => ['type' => 'string'],
+        'data' => [
+          'type' => 'object',
+          'properties' => $properties,
+        ],
+      ],
+      'required' => ['success', 'data'],
+    ];
+  }
+
