+    // `k` and `min_score` name two different searches, and OpenSearch rejects
+    // a clause carrying both.
+    $vector += $min_score > 0 ? ['min_score' => $min_score] : ['k' => $limit];
+    return ['knn' => ['vector' => $vector]];
+  }
