+  /**
+   * What a lexical-only search asks for, NULL where both arms run.
+   *
+   * A `lexical_only` option runs the match clause on its own: no vector is
+   * compared, so the caller needs none embedded. TRUE takes the default match
+   * type over every analyzed text field; a string names the match type; an
+   * array names either under `type` and `fields`. A named field the
+   * collection does not carry as analyzed text is not one, and is dropped.
+   *
+   * @param \Drupal\search_api\Query\QueryInterface $query
+   *   The query being run.
+   * @param string[] $text_fields
+   *   The analyzed text fields of the collection.
+   *
+   * @return array{type: string, fields: string[]}|null
+   *   The match type and the fields to match in, or NULL.
+   */
+  protected function lexicalOnly(QueryInterface $query, array $text_fields): ?array {
+    $option = $query->getOption('lexical_only', FALSE);
+    if ($option === FALSE || $option === NULL || $option === '' || $option === []) {
+      return NULL;
+    }
+    $option = is_array($option) ? $option : ['type' => is_string($option) ? $option : self::MATCH_TYPE];
+    $fields = isset($option['fields'])
+      ? array_values(array_intersect($text_fields, (array) $option['fields']))
+      : $text_fields;
+    return ['type' => (string) ($option['type'] ?? self::MATCH_TYPE), 'fields' => $fields];
+  }
+
+  /**
+   * What the lexical clause matched in, marked for an excerpt.
+   *
+   * @param string[] $text_fields
+   *   The analyzed text fields of the collection.
+   *
+   * @return array
+   *   The highlight definition.
+   */
+  protected function highlight(array $text_fields): array {
+    return [
+      'pre_tags' => [self::HIGHLIGHT_PRE],
+      'post_tags' => [self::HIGHLIGHT_POST],
+      'fields' => array_fill_keys($text_fields, (object) []),
+    ];
+  }
