+  /**
+   * The parsed keys of a query, as what scores a row and what excludes one.
+   *
+   * @param string[] $text_fields
+   *   The analyzed text fields of the collection.
+   * @param \Drupal\search_api\Query\QueryInterface $query
+   *   The query, whose parsed keys the clauses mirror. A quoted phrase is
+   *   re-imploded into loose words: the parsed keys carry no quoting.
+   *
+   * @return array{match: array, excluded: array[]}
+   *   The scoring clause, empty where the keys ask for nothing one can
+   *   answer, and the clauses a row must match none of.
+   */
+  protected function keyClauses(array $text_fields, QueryInterface $query): array {
+    $keys = $query->getKeys();
+    if (!is_array($keys)) {
+      $keys = trim((string) $keys);
+      return [
+        'match' => $keys === '' ? [] : $this->matchClause($text_fields, $keys, 'and'),
+        'excluded' => [],
+      ];
+    }
+    $excluded = [];
+    if (empty($keys['#negation'])) {
+      return ['match' => $this->keysClause($text_fields, $keys, $excluded), 'excluded' => $excluded];
+    }
+    // A query that is nothing but an exclusion scores nothing: what is left
+    // of the collection is answered by the kNN arm alone.
+    $group = $this->keysClause($text_fields, $keys, $excluded);
+    return ['match' => [], 'excluded' => $group === [] ? $excluded : [$group, ...$excluded]];
+  }
+
+  /**
+   * The lexical clause of a hybrid search, bound by the shared filters.
+   *
+   * @param array $match
+   *   The scoring clause keyClauses() built.
+   * @param mixed $filters
+   *   The filters the kNN arm is bound by, which bound this arm too.
+   *
+   * @return array
+   *   The clause, or an empty array where there is nothing to score.
+   */
+  protected function lexicalClause(array $match, mixed $filters): array {
+    return $match === []
+      ? []
+      : ['bool' => ['must' => [$match], 'filter' => $filters === '' ? [] : [$filters]]];
+  }
+
+  /**
