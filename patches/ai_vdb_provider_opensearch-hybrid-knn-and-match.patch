+   *
+   * @param string[] $text_fields
+   *   The analyzed text fields of the collection.
+   * @param string $keys
+   *   The words to match.
+   * @param string $operator
+   *   `and` when a row has to carry every word, `or` when one is enough.
+   *
+   * @return array
+   *   The clause.
+   */
+  protected function matchClause(array $text_fields, string $keys, string $operator): array {
+    return count($text_fields) === 1
+      ? ['match' => [reset($text_fields) => ['query' => $keys, 'operator' => $operator]]]
+      : ['multi_match' => ['query' => $keys, 'fields' => array_values($text_fields), 'operator' => $operator]];
+  }
+
+  /**
+   * The analyzed text fields of a collection, cached until it is recreated.
+   *
+   * @param string $index
+   *   The OpenSearch index name.
+   *
+   * @return string[]
+   *   The field names.
+   */
+  protected function textFields(string $index): array {
+    $cid = $this->textFieldsCacheId($index);
+    if ($cached = $this->cache->get($cid)) {
+      return $cached->data;
+    }
+    try {
+      $mappings = $this->getClient()->indices()->getMapping(['index' => $index]);
+    }
+    catch (\Exception) {
+      // A collection that cannot be read has no text fields to search on; the
+      // kNN clause alone still answers. Not remembered, so a collection that
+      // answers again is searched lexically again.
+      return [];
+    }
+    $fields = [];
+    foreach ($mappings[$index]['mappings']['properties'] ?? [] as $name => $definition) {
+      if (($definition['type'] ?? NULL) === 'text') {
+        $fields[] = $name;
+      }
+    }
+    $this->cache->set($cid, $fields);
+    return $fields;
+  }
+
+  /**
+   * The cache id the collection's text fields are held under.
+   */
+  protected function textFieldsCacheId(string $index): string {
+    return 'ai_vdb_provider_opensearch:text_fields:' . $index;
+  }
+
