# The reverse-proxy contract of the stack, as a working example:
# - one site per hostname, certificates obtained automatically,
# - X-Forwarded-For, -Proto and -Host reach both upstreams (Caddy sets them),
# - the frontend's X-Forwarded-For is kept: Drupal's login flood keys on it,
# - WebSockets on /collaboration pass through, idle connections are not cut,
# - the frontend's responses are compressed with zstd or gzip; precompressed
#   assets (br/gz from Nitro) pass through. Drupal compresses its own.

{
	# E.g. `acme_ca <url>` for a staging CA.
	{$CADDY_GLOBAL_OPTIONS}

	servers {
		trusted_proxies static private_ranges
	}
}

{$FRONTEND_HOST} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

{$DRUPAL_HOST} {
	reverse_proxy drupal:8080
}
