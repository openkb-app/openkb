+  /**
+   * The filters with the query's exclusions in them.
+   *
+   * @param mixed $filters
+   *   The filters prepareFilters() built.
+   * @param array[] $excluded
+   *   The clauses a row must match none of.
+   *
+   * @return mixed
+   *   The filters, unchanged where the query excludes nothing.
+   */
+  protected function withExclusions(mixed $filters, array $excluded): mixed {
+    if ($excluded === []) {
+      return $filters;
+    }
+    $clauses = $filters === '' || $filters === [] ? [] : [$filters];
+    $clauses[] = ['bool' => ['must_not' => $excluded]];
+    return ['bool' => ['filter' => $clauses]];
+  }
