###
### GitHub repository .gitignore section
###

# Ignore directories generated by Composer
/console/
/drush/Commands/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/web/private/scripts/quicksilver
/web/private/examples

# Ignore Drupal CMS stuff
/web/themes/blank

# Ignore transpiled js
/web/modules/custom/**/js/*.js
/web/modules/custom/**/js/**/*.js
/web/modules/custom/**/vue_templates/*.js
!/web/modules/custom/**/vue_templates/*.es6.js
/web/modules/custom/**/vue_templates/**/*.js
!/web/modules/custom/**/vue_templates/**/*.es6.js
!/web/modules/custom/**/js/*.es6.js
!/web/modules/custom/**/js/*.legacy.js
# Transpiled JS in the in-tree openkb package.
/openkb/**/js/*.js
/openkb/**/js/**/*.js
!/openkb/**/js/*.es6.js
!/openkb/**/js/*.legacy.js
/web/themes/custom/tableau_www/js/**/*.js
!/web/themes/custom/tableau_www/js/**/*.es6.js
!/web/themes/custom/tableau_www/js/**/*.legacy.js
/web/themes/custom/**/js/**/*.js
!/web/themes/custom/**/js/**/*.es6.js
!/web/themes/custom/**/js/**/*.legacy.js
*.js.map

# Ignore Node files
/node_modules/
package-lock.json
# Keep the frontend lockfile committed — required for reproducible npm ci
# in the frontend docker build.
!/frontend/package-lock.json

# Runtime files dir written by Drupal install (PERSISTENT_FILES_DIR=files).
/files/

# Composer and npm download caches of the development compose overlay.
/.cache/

# Ignore local bash files
.bashrc-local

# Ignore files generated by PhpStorm
.idea

# Ignore sensitive files
.env
# The evaluation stack ships its settings; they are public by design.
!quickstart/.env

# Packages #
############
*.7z
*.dmg
*.gz
*.bz2
*.iso
*.jar
*.rar
*.tar
*.zip
*.tgz

# Logs and databases #
######################
/database/
*.log

# OS generated files #
######################
.DS_Store*
ehthumbs.db
Icon
Thumbs.db
._*

# Vim generated files #
######################
*.un~

# Drupal sites: settings are tracked, generated content is not.
/web/sites/*/files
/web/sites/*/private
/web/sites/simpletest
/web/sites/*/settings.local.php
/web/sites/*/settings.build.php
/web/sites/*/services.build.yml
# Core scaffold READMEs.
/web/README.md
/web/*/README.txt
# Ignore artifacts
/artifacts

# Composer
# composer.lock is committed for reproducible installs — without it,
# `composer install` against a moving target like drupal/ai may pick up
# unrelated dependency drift. The project is a site repo, not a
# distribution, so the lock belongs in git.

# Lupus Decoupled Stuff
/recipes/*
!/recipes/openkb_recipe_main/
!/recipes/openkb_recipe_core/
!/recipes/openkb_recipe_demo/
!/recipes/openkb_recipe_demo_pages/
!/recipes/openkb_recipe_demo_outline/
!/recipes/openkb_recipe_demo_lupus_docs/
!/recipes/openkb_recipe_demo_lupus_docs_pages/
!/recipes/openkb_recipe_demo_lupus_docs_install/
!/recipes/openkb_recipe_agents/
!/recipes/openkb_recipe_chat/
!/recipes/openkb_recipe_chat_mock/
!/recipes/openkb_recipe_chunk_store/
!/recipes/openkb_recipe_embeddings_mock/
!/recipes/openkb_recipe_dev/
!/recipes/openkb_recipe_ci/
!/recipes/openkb_recipe_ai_logging/
!/recipes/openkb_recipe_collab/
!/recipes/openkb_recipe_base/
!/recipes/openkb_recipe_monitoring/
!/recipes/openkb_recipe_site_manager/
!/recipes/openkb_recipe_ai_guardrails/
!/recipes/openkb_recipe_user_guide/
!/recipes/openkb_recipe_starter_spaces/
# The generated install artifacts the published project ships.
!/recipes/install-state/
!/recipes/install-content/

# Allow using local config, version dist file.
phpcs.xml
phpunit.xml
.phpunit.result.cache
.playwright-cli/
.playwright-mcp/
frontend/test-results/
frontend/playwright-report/
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/playwright-results.xml
tests/playwright/results/
*.yaml
*.png
read-page.png
# The brand icon set the app serves (docs/branding.md).
!/frontend/public/*.png
# The images the recipes' default content ships, beside their file entities.
!/recipes/*/content/file/*.png

# Drupal runtime files dirs (configured via PERSISTENT_FILES_DIR).
/web/files

# Vitest junit output (CI vitest stages write it via the frontend bind mount).
/frontend/vitest-results.xml
/frontend/collab-integration-results.xml
# Vitest blob reports: the CI `vitest` stage replays them into logs/.
/frontend/.vitest/

# Full output of the stages that keep the console short; CI archives it.
/logs/

# Playwright runtime artifacts (every run writes them here, through the
# playwright container's bind mount).
/tests/playwright/node_modules/
/tests/playwright/results/

# Keep the playwright lockfile committed too.
!/tests/playwright/package-lock.json

# Per-environment server credentials, generated by scripts/setup-base.sh.
.collab-oauth
