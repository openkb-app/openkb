{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::8080} {
	root * web/
	encode zstd br gzip

	# The webserver's own cap on page file upload bodies. Drupal's field limits
	# (`max_filesize`) decide the size; this must stay above the largest one.
	# A longer body is refused with 413.
	@pageFileUpload path /jsonapi/node/kb_page/field_kb_attachments /jsonapi/node/kb_page/field_kb_images
	request_body @pageFileUpload {
		max_size {$WEBSERVER_UPLOAD_MAX_SIZE:100MB}
	}

	@static {
		file
		path *.avif *.css *.eot *.gif *.gz *.ico *.jpg *.jpeg *.js *.otf *.pdf *.png *.svg *.ttf *.webp *.woff *.woff2
	}
	header @static Cache-Control "max-age=31536000,public,immutable"

	# A `.openkb-holding` marker holds the site while it cannot answer:
	#  - /run/openkb: `openkb-entrypoint` puts it up for the install on a first
	#    boot,
	#  - the files volume: site-install.sh puts it up while Drupal installs, from
	#    whichever container runs it. A request served meanwhile would build its
	#    container from a half-installed module list and write that hook list
	#    over the installer's.
	# The matcher only tests that a marker exists; the page is served from a
	# directory that holds that one file, so no root here reaches the site's data.
	# The files directory is resolved against /app, as site-install.sh does.
	@holding file {
		root /
		try_files /run/openkb/.openkb-holding /app/{$PERSISTENT_FILES_DIR:files}/.openkb-holding
	}
	route @holding {
		root * /usr/local/share/openkb
		# Every path, so the whole site is held; only this one file is served.
		rewrite * /holding.html
		header Retry-After 10
		# What the frontend reads to hold its own page.
		header X-OpenKB-Hold install
		file_server {
			status 503
		}
	}

	# Runs in the order written. Two PHP files are executed: update.php and the
	# front controller web/index.php. An existing file other than a *.php file is
	# served; every other request goes to the front controller.
	route {
		# The operator's directives come first, so they can answer a request.
		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		# Dot files are never served, in any directory.
		@dotFiles {
			path */.*
			not path /.well-known/*
		}
		error @dotFiles 403

		@protectedFiles {
			not path /.well-known/*
			path_regexp \.(engine|inc|install|make|module|profile|po|sh|[^/]*sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|/(Entries[^/]*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config|yarn\.lock|package\.json)$|^\/#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$
		}
		error @protectedFiles 403

		# A path ending in a slash would match a directory.
		@staticFile {
			file
			not path */
			not path_regexp (?i)\.php$
		}
		file_server @staticFile

		# update.php runs the updates on core's update kernel, with path info.
		@updateScript path_regexp ^/update\.php(/|$)
		php @updateScript

		rewrite * /index.php
		php
	}
}
