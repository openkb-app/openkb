<?php

/**
 * @file
 * Install and update hooks for Simple OAuth Personal Consumers.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Add the consumer `created` and `last_used` fields and the sweep retention.
 */
function simple_oauth_personal_consumers_update_10001(): void {
  \Drupal::configFactory()
    ->getEditable('simple_oauth_personal_consumers.settings')
    ->set('unclaimed_retention', 604800)
    ->save();

  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('consumer');
  $created = $definitions['created'];
  assert($created instanceof BaseFieldDefinition);
  // Consumers that predate the field have no knowable creation time, so they
  // start ageing here — the earliest moment their age can be proven from.
  $created->setInitialValue(\Drupal::time()->getRequestTime());

  $update_manager->installFieldStorageDefinition('created', 'consumer', 'simple_oauth_personal_consumers', $created);
  $update_manager->installFieldStorageDefinition('last_used', 'consumer', 'simple_oauth_personal_consumers', $definitions['last_used']);
}
