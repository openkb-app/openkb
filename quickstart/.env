# Settings of the OpenKB evaluation stack (docker-compose.yml next to this
# file). Everything is filled in; README.md next to it walks through it.
#
# EVALUATION ONLY. The passwords below are published with this file, so they
# are public, and both services stay on 127.0.0.1. A real install starts from
# the project's .env.example and docs/self-hosting.md.

# The released images, built for amd64 and arm64. `1.x` follows the development
# branch instead, and is built for amd64 only.
OPENKB_TAG=1.0.0-alpha1

## The two URLs. Uncommon ports, so they collide with little; they appear in
## the URLs above -- change them together.
DRUPAL_FRONTEND_BASE_URL=http://localhost:8642
DRUPAL_BASE_URL=http://localhost:8643
FRONTEND_HTTP_PORT=8642
DRUPAL_HTTP_PORT=8643
# The address both ports are published on. Keep it on loopback.
#LISTEN_IP=127.0.0.1

## Public, fixed values. See the warning above.
DRUPAL_HASH_SALT=openkb-evaluation-only-not-a-secret
MARIADB_PASSWORD=openkb
MARIADB_ROOT_PASSWORD=openkb
OKB_COLLAB_CLIENT_ID=openkb-evaluation
OKB_COLLAB_CLIENT_SECRET=openkb-evaluation-only-not-a-secret
# The `admin` account's password.
ADMIN_PASSWORD=admin

# Off, so the host needs no `sysctl vm.max_map_count=262144`. A real index
# wants it on.
OPENSEARCH_ALLOW_MMAP=false
# A laptop-sized heap; the stack needs ~2 GB of RAM with it.
OPENSEARCH_JAVA_OPTS=-Xms256m -Xmx256m

# Enables the AI chat and the semantic index. Without it the two stay unusable
# and the rest runs.
#OPENAI_API_KEY=
