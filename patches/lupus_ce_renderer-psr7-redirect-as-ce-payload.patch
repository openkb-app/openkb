   /**
+   * The URL a response redirects to, or NULL when it is not a redirect.
+   *
+   * A controller may answer in PSR-7 rather than in HttpFoundation — the
+   * OAuth2 server behind simple_oauth's /oauth/authorize is one such. Core's
+   * PsrResponseSubscriber converts those to a plain Response carrying the
+   * status and the Location header, never to a RedirectResponse, so matching
+   * on the class alone would let a 302 leave the API as a raw redirect that
+   * the client's own HTTP layer follows server-side.
+   *
+   * @param \Symfony\Component\HttpFoundation\Response $response
+   *   The response to inspect.
+   *
+   * @return string|null
+   *   The target URL, or NULL.
+   */
+  protected function redirectTarget(Response $response): ?string {
+    if ($response instanceof RedirectResponse) {
+      return $response->getTargetUrl();
+    }
+    // 304 and 305 are redirection statuses that carry no target.
+    return $response->isRedirection() && $response->headers->has('location')
+      ? (string) $response->headers->get('location')
+      : NULL;
+  }
