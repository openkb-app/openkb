diff --git a/src/Event/CollectionMappingEvent.php b/src/Event/CollectionMappingEvent.php
new file mode 100644
index 0000000..81b0c26
--- /dev/null
+++ b/src/Event/CollectionMappingEvent.php
@@ -0,0 +1,60 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\ai_vdb_provider_opensearch\Event;
+
+use Symfony\Contracts\EventDispatcher\Event;
+
+/**
+ * Names the settings and the mappings a collection is created with.
+ *
+ * The provider maps every field beside the vector as a keyword, which is what
+ * filtering needs. A site searching a field lexically declares it as analyzed
+ * text here, together with the analyzer it is read with: both are fixed when
+ * the collection is created and a later change needs it recreated.
+ */
+final class CollectionMappingEvent extends Event {
+
+  public function __construct(
+    private readonly string $collection,
+    private array $settings,
+    private array $mappings,
+  ) {}
+
+  /**
+   * The collection being created.
+   */
+  public function getCollection(): string {
+    return $this->collection;
+  }
+
+  /**
+   * The index settings, analysis included.
+   */
+  public function getSettings(): array {
+    return $this->settings;
+  }
+
+  /**
+   * Replaces the index settings.
+   */
+  public function setSettings(array $settings): void {
+    $this->settings = $settings;
+  }
+
+  /**
+   * The index mappings.
+   */
+  public function getMappings(): array {
+    return $this->mappings;
+  }
+
+  /**
+   * Replaces the index mappings.
+   */
+  public function setMappings(array $mappings): void {
+    $this->mappings = $mappings;
+  }
+
+}
